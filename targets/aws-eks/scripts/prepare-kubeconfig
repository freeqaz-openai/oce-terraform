#!/usr/bin/env python3
"""Write a fresh EKS kubeconfig that matches the applied Terraform cluster."""

import argparse
import base64
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

from eks_kubeconfig import eks_connection, parse_tunnel_port, require_kuberc_opt_out, verify_eks_view


def run(phase, *command):
    """Keep provider output out of errors because it can contain credentials."""
    try:
        return subprocess.run(
            command, check=True, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, timeout=60,
            env={
                **os.environ,
                "AWS_IGNORE_CONFIGURED_ENDPOINT_URLS": "true",
            },
        ).stdout
    except FileNotFoundError:
        raise ValueError(f"{phase} requires {command[0]} on PATH.") from None
    except subprocess.TimeoutExpired:
        raise ValueError(f"{phase} timed out after 60 seconds.") from None
    except subprocess.CalledProcessError as error:
        raise ValueError(f"{phase} failed (exit {error.returncode}).") from None


def read_json(phase, *command):
    try:
        return json.loads(run(phase, *command))
    except (UnicodeError, json.JSONDecodeError):
        raise ValueError(f"{phase} did not return JSON.") from None


def read_cluster():
    cluster = read_json("Read applied Terraform output", "terraform", "output", "-json", "oce_cluster")
    fields = ("region", "name", "arn", "endpoint", "certificate_authority_data")
    if not isinstance(cluster, dict) or any(
        not isinstance(cluster.get(name), str) or not cluster[name] for name in fields
    ):
        raise ValueError("The applied state needs the oce_cluster output from this repository.")
    region, name, arn, endpoint, ca = (cluster[field] for field in fields)
    if (
        not re.fullmatch(r"[a-z]{2}-[a-z]+-[0-9]+", region)
        or not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", name)
        or not re.fullmatch(r"arn:aws:eks:" + re.escape(region) + r":[0-9]{12}:cluster/" + re.escape(name), arn)
    ):
        raise ValueError("The Terraform cluster name, region, and ARN must identify the same cluster.")
    if not re.fullmatch(r"https://[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)+", endpoint):
        raise ValueError("The Terraform cluster endpoint must be an EKS HTTPS hostname.")
    try:
        if not base64.b64decode(ca, validate=True):
            raise ValueError("Empty CA")
    except ValueError:
        raise ValueError("The Terraform output has invalid certificate authority data.") from None
    return cluster


def check_foundation(kube):
    nodes = read_json("Read nodes (check API access and the operator role)", *kube, "get", "nodes", "-o", "json")
    placements = {"control": [], "agents": []}
    for node in nodes.get("items", []):
        metadata = node.get("metadata", {})
        labels = metadata.get("labels", {})
        pool = labels.get("oce-role")
        zone = labels.get("topology.kubernetes.io/zone")
        conditions = node.get("status", {}).get("conditions", [])
        if (
            pool in placements and labels.get("eks.amazonaws.com/nodegroup") == pool
            and zone and not node.get("spec", {}).get("unschedulable")
            and not metadata.get("deletionTimestamp")
            and any(c.get("type") == "Ready" and c.get("status") == "True" for c in conditions)
        ):
            placements[pool].append(zone)
    for pool, zones in placements.items():
        if not zones:
            raise ValueError(f"No Ready, schedulable {pool} node with its EKS pool and zone labels. Check the managed node group.")
    required = {
        "aws-node": "daemonset/aws-node",
        "kube-proxy": "daemonset/kube-proxy",
        "ebs-csi-node": "daemonset/ebs-csi-node",
        "ebs-csi-controller": "deployment/ebs-csi-controller",
        "coredns": "deployment/coredns",
    }
    observed = read_json(
        "Read VPC CNI and system add-ons", *kube, "-n", "kube-system",
        "get", *required.values(), "configmap/amazon-vpc-cni", "-o", "json",
    )
    workloads = {obj.get("metadata", {}).get("name"): obj for obj in observed.get("items", [])}
    containers = {
        container.get("name"): container
        for container in workloads.get("aws-node", {}).get("spec", {})
        .get("template", {}).get("spec", {}).get("containers", [])
    }
    env = containers.get("aws-node", {}).get("env", [])
    mode = [entry.get("value") for entry in env if entry.get("name") == "NETWORK_POLICY_ENFORCING_MODE"]
    policy_flags = [
        arg
        for name in ("aws-eks-nodeagent", "aws-network-policy-agent")
        for arg in containers.get(name, {}).get("args", [])
        if arg.startswith("--enable-network-policy=")
    ]
    policy_controller = workloads.get("amazon-vpc-cni", {}).get("data", {}).get("enable-network-policy-controller")
    if mode != ["strict"] or policy_flags != ["--enable-network-policy=true"] or policy_controller != "true":
        raise ValueError("VPC CNI needs network policy enabled and aws-node in strict mode. Apply the reviewed policy and Terraform changes.")
    node_count = sum(len(zones) for zones in placements.values())
    for name, kind in required.items():
        workload = workloads.get(name, {})
        status = workload.get("status", {})
        generation = workload.get("metadata", {}).get("generation")
        if kind.startswith("daemonset/"):
            desired = status.get("desiredNumberScheduled", 0)
            ready = (
                desired >= node_count
                and all(status.get(key) == desired for key in (
                    "numberReady", "numberAvailable", "updatedNumberScheduled"
                ))
            )
        else:
            desired = workload.get("spec", {}).get("replicas", 1)
            ready = (
                desired > 0
                and all(status.get(key) == desired for key in (
                    "replicas", "availableReplicas", "updatedReplicas", "readyReplicas"
                ))
            )
        if not ready or generation is None or status.get("observedGeneration") != generation:
            raise ValueError(f"{kind} rollout is incomplete in kube-system. Check Events and controller readiness.")

    classes = read_json("Read StorageClasses", *kube, "get", "storageclass", "-o", "json").get("items", [])
    defaults = []
    for storage in classes:
        annotations = storage.get("metadata", {}).get("annotations", {})
        if any(annotations.get(key) == "true" for key in (
            "storageclass.kubernetes.io/is-default-class",
            "storageclass.beta.kubernetes.io/is-default-class",
        )):
            defaults.append(storage)
    if len(defaults) != 1 or defaults[0].get("metadata", {}).get("name") != "encrypted-gp3":
        raise ValueError("Make encrypted-gp3 the single default StorageClass. Review the existing classes and examples/encrypted-gp3.yaml.")
    storage = defaults[0]
    parameters = storage.get("parameters", {})
    if (
        storage.get("provisioner") != "ebs.csi.aws.com"
        or parameters.get("type") != "gp3"
        or parameters.get("encrypted") != "true"
        or storage.get("volumeBindingMode") != "WaitForFirstConsumer"
        or storage.get("reclaimPolicy") != "Retain"
    ):
        raise ValueError("Default StorageClass encrypted-gp3 must use encrypted EBS gp3 with WaitForFirstConsumer and Retain.")
    for pool, zones in placements.items():
        counts = ", ".join(f"{zone}={zones.count(zone)}" for zone in sorted(set(zones)))
        print(f"Ready {pool} nodes by zone: {counts}", file=sys.stderr)
    print("VPC CNI strict configuration, add-on rollouts, and encrypted-gp3 default verified.", file=sys.stderr)


def write_kubeconfig(destination, check=False, *, tunnel_port=None):
    if check:
        require_kuberc_opt_out()
    output = Path(destination).expanduser()
    parent = output.parent.resolve(strict=True)
    if not parent.is_dir() or parent.stat().st_uid != os.getuid() or parent.stat().st_mode & 0o077:
        raise ValueError("Use an existing output directory owned by you with mode 0700.")
    output = parent / output.name
    if os.path.lexists(output):
        raise ValueError("The kubeconfig path already exists. Choose a new file.")

    cluster = read_cluster()
    name = cluster["name"]
    context = f"oce-{name}"
    aws = ("aws", "--region", cluster["region"], "--no-cli-pager", "--no-cli-auto-prompt", "eks")
    observed = read_json(
        "Read the EKS cluster", *aws, "describe-cluster", "--name", name, "--output", "json"
    )
    try:
        details = observed["cluster"]
        matches = (
            details["status"] == "ACTIVE"
            and all(details[key] == cluster[key] for key in ("name", "arn", "endpoint"))
            and details["certificateAuthority"]["data"] == cluster["certificate_authority_data"]
        )
    except (KeyError, TypeError):
        matches = False
    if not matches:
        raise ValueError("The active EKS cluster does not match Terraform's ARN, endpoint, and CA.")

    with tempfile.TemporaryDirectory(prefix=".oce-kubeconfig-", dir=parent) as staging:
        staged = Path(staging) / "kubeconfig"
        generated = run(
            "Generate the EKS kubeconfig", *aws, "update-kubeconfig", "--name", name,
            "--alias", context, "--kubeconfig", str(staged), "--dry-run",
        )
        staged.write_bytes(generated)
        staged.chmod(0o600)
        kube = ("kubectl", "--kubeconfig", str(staged), "--context", context, "--request-timeout=15s")
        view = read_json("Inspect the generated kubeconfig", *kube, "config", "view", "--minify", "--raw", "-o", "json")
        verify_eks_view(view, context, cluster["arn"], cluster["endpoint"], cluster["certificate_authority_data"])
        if tunnel_port is not None:
            view["clusters"][0]["cluster"] = eks_connection(
                cluster["endpoint"], cluster["certificate_authority_data"], tunnel_port=tunnel_port,
            )
        # Use the verified view during readiness reads and in the resulting file.
        # This drops unrelated contexts and preserves the exact checked token command.
        staged.write_text(json.dumps(view, indent=2) + "\n")
        if check:
            check_foundation(kube)
        # Publish the complete file atomically and refuse a concurrent writer.
        os.link(staged, output)
    return context


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="Verify cluster readiness before publishing the kubeconfig")
    parser.add_argument("--tunnel-port", type=parse_tunnel_port, metavar="PORT", help="Use an existing IPv4 loopback tunnel to the verified EKS endpoint")
    parser.add_argument("kubeconfig", help="New kubeconfig path in an existing private directory")
    args = parser.parse_args()
    os.umask(0o077)
    try:
        print(write_kubeconfig(args.kubeconfig, check=args.check, tunnel_port=args.tunnel_port))
    except FileExistsError:
        parser.exit(1, "Kubeconfig path already exists. Choose a new file.\n")
    except (OSError, ValueError) as error:
        parser.exit(1, f"{error}\n")


if __name__ == "__main__":
    main()
